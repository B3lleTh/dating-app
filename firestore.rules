// Reglas de seguridad para Firestore
// Cópialas en: Firebase Console → Firestore Database → Reglas
// Permite leer/escribir SOLO la colección "places" (abierta para ustedes dos,
// sin login). Si más adelante agregan autenticación, se puede restringir más.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /places/{placeId} {
      allow read, write: if true;
    }
  }
}
